# mesa-mcp environment-variable form of `config.yaml.example`.
#
# Copy to `.env` and edit. The MESA_MCP_ prefix plus a double underscore
# delimiter maps onto the nested config layout:
#
#     MESA_MCP_<section>__<field>=<value>
#
# Precedence (highest wins): CLI flag > env var > YAML file > defaults.

# --- iRODS / CyVerse Data Store ------------------------------------------
MESA_MCP_IRODS__HOST=data.cyverse.org
MESA_MCP_IRODS__PORT=1247
MESA_MCP_IRODS__ZONE=iplant
MESA_MCP_IRODS__USER=anonymous
# NEVER commit a real password. Use a secret manager and source this file
# only into shell sessions, not into version control.
MESA_MCP_IRODS__PASSWORD=
MESA_MCP_IRODS__SHARED_DIR_NAME=shared
MESA_MCP_IRODS__WEBDAV_URL=https://data.cyverse.org/dav/
MESA_MCP_IRODS__PROXY_AUTH=false

# --- OBO / EMBL-EBI Ontology Lookup Service ------------------------------
MESA_MCP_OLS__BASE_URL=https://www.ebi.ac.uk/ols4/api
MESA_MCP_OLS__ONTOLOGY_CACHE_TTL=3600
MESA_MCP_OLS__TERM_CACHE_TTL=600
MESA_MCP_OLS__SEARCH_CACHE_TTL=60
MESA_MCP_OLS__REQUEST_TIMEOUT=30.0

# --- DuckLake AVU history ------------------------------------------------
# Postgres DSN for the DuckLake catalog. Leave blank to disable AVU-history
# mirroring (writes still succeed; they just aren't recorded).
MESA_MCP_DUCKLAKE__CATALOG_DSN=
MESA_MCP_DUCKLAKE__DATA_COLLECTION=.mesa/ducklake

# --- Server transport + OIDC --------------------------------------------
MESA_MCP_SERVER__TRANSPORT=stdio
MESA_MCP_SERVER__BIND_ADDRESS=127.0.0.1
MESA_MCP_SERVER__BIND_PORT=8080

# CyVerse Keycloak OIDC. Required only for HTTP/SSE transports.
# MESA_MCP_SERVER__OIDC_DISCOVERY_URL=https://kc.cyverse.org/realms/CyVerse/.well-known/openid-configuration
# MESA_MCP_SERVER__OAUTH2_CLIENT_ID=mesa-mcp
# MESA_MCP_SERVER__OAUTH2_CLIENT_SECRET=REPLACE_ME

MESA_MCP_SERVER__LOG_LEVEL=info
